# =============================================================================
# AppFlowy Cloud - environment template
# Copy this file to .env in the same directory and fill in real values, or run:
#   bash scripts/generate-appflowy-env.sh
# to generate docker/appflowy/.env with fresh random secrets.
# The .env file is gitignored; this template is the tracked reference.
#
# NOTE: docker compose does NOT interpolate values inside an env_file, so the
# database URLs below embed the password literally. Keep POSTGRES_PASSWORD and
# the URLs in sync if you rotate it. Use URL-encoded values if the password
# contains special characters (e.g. p@ssword -> p%40ssword).
#
# The AppFlowy base URL/domain (https://appflowy.your-domain.com) is
# interpolated from BASE_DOMAIN in the root .env via compose.yml, not from
# this file.
# =============================================================================

# --- AppFlowy Postgres (dedicated pgvector instance) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=postgres
POSTGRES_PORT=5432

# --- Redis (reuses the existing shared 'redis' service) ---
APPFLOWY_REDIS_URI=redis://redis:6379
APPFLOWY_WORKER_REDIS_URL=redis://redis:6379
APPFLOWY_SEARCH_REDIS_URL=redis://redis:6379

# --- MinIO / S3 object storage ---
# MINIO_ROOT_USER/PASSWORD must match APPFLOWY_S3_ACCESS_KEY/SECRET_KEY
MINIO_ROOT_USER=CHANGE_ME
MINIO_ROOT_PASSWORD=CHANGE_ME
APPFLOWY_S3_ACCESS_KEY=CHANGE_ME
APPFLOWY_S3_SECRET_KEY=CHANGE_ME
APPFLOWY_S3_BUCKET=appflowy

# --- GoTrue authentication ---
GOTRUE_ADMIN_EMAIL=admin@example.com
GOTRUE_ADMIN_PASSWORD=CHANGE_ME
GOTRUE_JWT_SECRET=CHANGE_ME_LONG
APPFLOWY_GOTRUE_JWT_SECRET=SAME_AS_GOTRUE_JWT_SECRET
GOTRUE_JWT_EXP=604800

# --- Database connection strings (password matches POSTGRES_PASSWORD) ---
APPFLOWY_DATABASE_URL=postgres://postgres:CHANGE_ME@appflowy_postgres:5432/postgres
GOTRUE_DATABASE_URL=postgres://postgres:CHANGE_ME@appflowy_postgres:5432/postgres?search_path=auth
# GoTrue reads DATABASE_URL directly (same value as GOTRUE_DATABASE_URL)
DATABASE_URL=postgres://postgres:CHANGE_ME@appflowy_postgres:5432/postgres?search_path=auth
APPFLOWY_WORKER_DATABASE_URL=postgres://postgres:CHANGE_ME@appflowy_postgres:5432/postgres
APPFLOWY_WORKER_DATABASE_NAME=postgres
APPFLOWY_SEARCH_DATABASE_URL=postgres://postgres:CHANGE_ME@appflowy_postgres:5432/postgres

# --- SMTP (docker-mailserver relay) ---
# FILL THESE IN: the generator fills the domain placeholders (mail.<domain> /
# user@<domain>) using BASE_DOMAIN from the root .env. Set the password you
# chose when creating the account:
#   cd services/docker-mailserver && ./setup.sh email add no-reply@<domain> <password>
GOTRUE_SMTP_HOST=mail.CHANGE_ME
GOTRUE_SMTP_PORT=587
GOTRUE_SMTP_USER=no-reply@CHANGE_ME
GOTRUE_SMTP_PASS=FILL_ME
GOTRUE_SMTP_ADMIN_EMAIL=postmaster@CHANGE_ME
APPFLOWY_MAILER_SMTP_HOST=mail.CHANGE_ME
APPFLOWY_MAILER_SMTP_PORT=587
APPFLOWY_MAILER_SMTP_USERNAME=no-reply@CHANGE_ME
APPFLOWY_MAILER_SMTP_EMAIL=no-reply@CHANGE_ME
APPFLOWY_MAILER_SMTP_PASSWORD=FILL_ME
APPFLOWY_MAILER_SMTP_TLS_KIND=required
